    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Bogus" Version="35.6.5" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageReference Include="SSH.NET" Version="2026.0.0" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
        <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
        <PackageReference Include="Dapper" Version="2.1.89" />
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\..\examples\AdoGen.Sample\AdoGen.Sample.csproj"/>
        <ProjectReference Include="..\AdoGen.SqlServer\AdoGen.SqlServer.csproj" />
